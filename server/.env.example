PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/menuqr

# JWT Authentication
JWT_SECRET=your_super_secret_random_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS + cookie settings)
CLIENT_URL=http://localhost:5173

# Cloudinary (for food photos & restaurant logos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (UPI, Cards, NetBanking)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
